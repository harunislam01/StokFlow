# docker-compose.prod.yml için gerekli değişkenler
# Bu dosyayı `.env` olarak kopyalayıp değerleri doldurun:
#   cp .env.example .env

# PostgreSQL şifresi (URL-güvenli karakterler kullanın: harf, rakam, - ve _)
POSTGRES_PASSWORD=change_me_to_a_long_random_value

# Frontend farklı bir domainden sunulacaksa izin verilen origin(ler), virgülle ayrılır.
# Nginx aynı origin üzerinden /api proxy'liyorsa boş bırakın.
CORS_ORIGIN=
